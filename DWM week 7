        "def calculate_support(itemset, transactions):\n",
        "    count = 0\n",
        "\n",
        "    itemset = set(itemset)\n",
        "\n",
        "    for transaction in transactions:\n",
        "        if itemset.issubset(set(transaction)):\n",
        "            count += 1\n",
        "\n",
        "    return count / len(transactions)"
      ],
