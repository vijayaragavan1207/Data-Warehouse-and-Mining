      "execution_count": 19,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def calculate_lift(\n",
        "    support_itemset,\n",
        "    support_antecedent,\n",
        "    support_consequent\n",
        "):\n",
        "\n",
        "    if support_antecedent == 0 or support_consequent == 0:\n",
        "        return 0\n",
        "\n",
        "    return (\n",
        "        support_itemset /\n",
        "        (support_antecedent * support_consequent)\n",
        "    )"
      ],
      "metadata": {
        "id": "IEiSGNy5E-0f"
      },
      "execution_count": 20,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def calculate_conviction(\n",
        "    confidence,\n",
        "    support_consequent\n",
        "):\n",
        "\n",
        "    if confidence >= 1:\n",
        "        return float(\"inf\")\n",
        "\n",
        "    if support_consequent == 1:\n",
        "        return float(\"inf\")\n",
        "\n",
        "    return (\n",
        "        (1 - support_consequent) /\n",
        "        (1 - confidence)\n",
        "    )"
      ],
      "metadata": {
        "id": "2s4FLD8WFI-Y"
      },
      "execution_count": 21,
      "outputs": []
    },
    {
