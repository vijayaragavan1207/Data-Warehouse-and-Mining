        "def count_candidates_in_partition(\n",
        "    partition,\n",
        "    candidates,\n",
        "    hash_tree\n",
        "):\n",
        "    counts = defaultdict(int)\n",
        "\n",
        "    for transaction in partition:\n",
        "\n",
        "        for candidate in candidates:\n",
        "\n",
        "            if not verify_candidate(hash_tree, candidate):\n",
        "                continue\n",
        "\n",
        "            if candidate.issubset(transaction):\n",
        "                counts[candidate] += 1\n",
        "\n",
        "    return counts"
