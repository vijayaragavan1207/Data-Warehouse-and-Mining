    {
      "cell_type": "code",
      "source": [
        "def verify_candidate(tree, itemset):\n",
        "    current = tree.root\n",
        "\n",
        "    for item in sorted(itemset):\n",
        "        if item not in current.children:\n",
        "            return False\n",
        "\n",
        "        current = current.children[item]\n",
        "\n",
        "    return frozenset(itemset) in current.candidates"
      ],
